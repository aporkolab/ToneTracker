{
  "name": "tonetracker",
  "version": "1.0.0",
  "description": "A color guessing game.",
  "main": "src/js/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/js/**/*.js\"",
    "format": "prettier --write \"src/js/**/*.js\"",
    "format:check": "prettier --check \"src/js/**/*.js\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "e2e:install": "npx playwright install",
    "e2e": "./scripts/test-e2e.sh",
    "e2e:dev": "npx playwright test",
    "e2e:ui": "npx playwright test --ui",
    "serve": "python3 -m http.server 8080 --directory dist",
    "analyze": "npx vite-bundle-analyzer dist",
    "performance:audit": "npx lighthouse http://localhost:8080 --output=html --output-path=./lighthouse-report.html",
    "performance:audit:ci": "npx lighthouse http://localhost:8080 --chrome-flags=\"--headless --no-sandbox --disable-gpu --disable-dev-shm-usage --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding\" --output=html --output-path=./lighthouse-report.html",
    "pwa:validate": "npx pwa-asset-generator src/assets/logo.svg assets/icons --background '#4f46e5' --index ./index.html",
    "security:audit": "npm audit",
    "size:check": "npx bundlesize"
  },
  "keywords": [
    "color",
    "game",
    "guess"
  ],
  "author": "Dr. Porkoláb Ádám",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "bundlesize": "^0.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "axios": "^1.21.0",
    "follow-redirects": "^1.16.2",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
